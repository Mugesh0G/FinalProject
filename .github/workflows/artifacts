name: Sprint artifacts

on:
  push:
    tags:
      - '*sprint-artifact*'
  workflow_dispatch:
    inputs:
      tag:
        description: Existing sprint-artifact tag
        required: true
        type: string

permissions:
  contents: read
  actions: read

jobs:
  package:
    runs-on: ubuntu-latest

    services:
      mysql:
        image: mysql:8.0
        env:
          MYSQL_ROOT_PASSWORD: ci-only-password
          MYSQL_DATABASE: hello
        ports:
          - 3306:3306
        options: >-
          --health-cmd="mysqladmin ping -h 127.0.0.1 -uroot -pci-only-password"
          --health-interval=10s
          --health-timeout=10s
          --health-retries=10

    env:
      TAG: ${{ github.event_name == 'workflow_dispatch' && inputs.tag || github.ref_name }}

    steps:
      - name: Validate tag
        shell: bash
        run: |
          if [[ "$TAG" != *"sprint-artifact"* ]]; then
            echo "The tag must contain 'sprint-artifact'."
            exit 1
          fi

      - name: Check out tag
        uses: actions/checkout@v4
        with:
          ref: ${{ env.TAG }}

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '11'
          cache: maven
          cache-dependency-path: Placements/pom.xml

      - name: Build
        working-directory: Placements
        env:
          SPRING_DATASOURCE_URL: jdbc:mysql://127.0.0.1:3306/hello
          SPRING_DATASOURCE_USERNAME: root
          SPRING_DATASOURCE_PASSWORD: ci-only-password
        run: mvn --batch-mode --no-transfer-progress package

      - name: Create ZIP
        shell: bash
        run: |
          JAR="$(find Placements/target -maxdepth 1 -type f -name '*.jar' ! -name '*.original' | head -n 1)"
          test -n "$JAR"
          mkdir dist
          zip -j "dist/placements-${TAG}.zip" "$JAR"

      - name: Upload sprint artifact
        uses: actions/upload-artifact@v4
        with:
          name: placements-${{ env.TAG }}
          path: dist/*.zip
          if-no-files-found: error
          retention-days: 90
